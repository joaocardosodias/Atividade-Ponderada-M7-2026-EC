# Copie para .env e troque todos os valores. O .env não vai para o git.

# PostgreSQL
POSTGRES_USER=btc_app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=btc_models

# MinIO (S3)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=troque-esta-senha-com-8-ou-mais-caracteres
MINIO_BUCKET=models

# Autenticação da API
# Gere o segredo com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE_MINUTES=60

# Primeiro usuário, criado na subida se a tabela users estiver vazia
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
